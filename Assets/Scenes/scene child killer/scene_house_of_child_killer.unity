    rightSprite: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
    lines:
    - speaker: 1
      expression: {fileID: 729778127006119710, guid: 430326d9d24a4884ea580f1d34841021, type: 3}
      text: "\u0E19\u0E35\u0E48\u0E40\u0E18\u0E2D\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E22\u0E34\u0E19\u0E17\u0E35\u0E48\u0E04\u0E38\u0E22\u0E01\u0E31\u0E19\u0E40\u0E2B\u0E23\u0E2D..\u0E08\u0E39\u0E48 \u0E46 \u0E01\u0E47\u0E08\u0E30\u0E1E\u0E32\u0E40\u0E02\u0E32\u0E44\u0E1B\u0E40\u0E19\u0E35\u0E48\u0E22\u0E19\u0E30"
    - speaker: 0
      expression: {fileID: -8333434954521013970, guid: d787bed976c0fe44f98796dd68f7ad74, type: 3}
      text: "\u0E04\u0E19\u0E17\u0E35\u0E48\u0E1E\u0E32\u0E04\u0E19\u0E41\u0E1B\u0E25\u0E01\u0E2B\u0E19\u0E49\u0E32\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E41\u0E17\u0E19\u0E40\u0E14\u0E47\u0E01\u0E1D\u0E36\u0E01\u0E07\u0E32\u0E19\u0E19\u0E48\u0E30\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2A\u0E34\u0E17\u0E18\u0E34\u0E4C\u0E1E\u0E39\u0E14\u0E2B\u0E23\u0E2D\u0E01\u0E19\u0E30..."
    - speaker: 1
      expression: {fileID: -6666077834460347998, guid: a3a88626f312fdd459fcefe67df7fd97, type: 3}
      text: "\u0E19\u0E48\u0E32\u0E2D\u0E32\u0E22\u0E0A\u0E30\u0E21\u0E31\u0E14"
    - speaker: 1
