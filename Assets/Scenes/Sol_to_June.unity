--- !u!114 &1881835518
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1881835516}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f8c0cbdc1b655b4f80cc617ebd0f2db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogueTrigger
  nextSceneName: Drawing minigame
  loadDelay: 0.5
  dialogueManager: {fileID: 1342429134}
  playerMovement: {fileID: 849242486}
  secondCharacter: {fileID: 0}
  firstCharacter: {fileID: 0}
  steps:
  - note: introduce
    type: 0
    showLeft: 0
    showRight: 1
    leftNameSprite: {fileID: 0}
    rightNameSprite: {fileID: -8052914020376505181, guid: 83908faf13289564fa84d263999d36a6, type: 3}
    lines:
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E44\u0E07!"
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E41\u0E25\u0E49\u0E27\u0E01\u0E47 \u0E09\u0E31\u0E19\u0E0A\u0E37\u0E48\u0E2D \u0E08\u0E39\u0E19 \u0E19\u0E30 \u0E09\u0E31\u0E19\u0E23\u0E39\u0E49\u0E0A\u0E37\u0E48\u0E2D\u0E40\u0E18\u0E2D\u0E21\u0E32\u0E15\u0E31\u0E49\u0E07\u0E41\u0E15\u0E48\u0E17\u0E35\u0E48\u0E42\u0E0B\u0E25\u0E1E\u0E39\u0E14\u0E41\u0E25\u0E49\u0E27\u0E25\u0E30"
      showName: 1
    - speaker: 1
      expression: {fileID: -8333434954521013970, guid: d787bed976c0fe44f98796dd68f7ad74, type: 3}
      text: "\u0E08\u0E23\u0E34\u0E07\u0E46\u0E09\u0E31\u0E19\u0E2D\u0E22\u0E32\u0E01\u0E2B\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E0A\u0E2D\u0E1A\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19 \u0E46 \u0E01\u0E31\u0E19\u0E19\u0E48\u0E30\u0E41\u0E15\u0E48\u0E17\u0E38\u0E01\u0E04\u0E19\u0E22\u0E38\u0E48\u0E07\u0E01\u0E31\u0E1A\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E01\u0E31\u0E19\u0E2B\u0E21\u0E14\u0E40\u0E25\u0E22..."
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E09\u0E31\u0E19\u0E19\u0E48\u0E30\u0E0A\u0E2D\u0E1A\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E28\u0E34\u0E25\u0E1B\u0E30\u0E21\u0E32\u0E01\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E0A\u0E2D\u0E1A\u0E40\u0E1E\u0E49\u0E2D\u0E16\u0E36\u0E07\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E15\u0E48\u0E32\u0E07\u0E46\u0E44\u0E1B\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E09\u0E31\u0E19\u0E19\u0E48\u0E30\u0E0A\u0E2D\u0E1A\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E28\u0E34\u0E25\u0E1B\u0E30\u0E21\u0E32\u0E01\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E15\u0E31\u0E27\u0E40\u0E2D\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E0A\u0E2D\u0E1A\u0E40\u0E1E\u0E49\u0E2D\u0E16\u0E36\u0E07\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E15\u0E48\u0E32\u0E07\u0E46\u0E44\u0E1B\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E1E\u0E27\u0E01\u0E19\u0E35\u0E49\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E44\u0E14\u0E48\u0E1B\u0E25\u0E14\u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E39\u0E48\u0E20\u0E32\u0E22\u0E43\u0E19\u0E40\u0E25\u0E22\u0E25\u0E48\u0E30 \u0E41\u0E16\u0E21\u0E22\u0E31\u0E07\u0E44\u0E14\u0E49\u0E43\u0E0A\u0E49\u0E2A\u0E21\u0E32\u0E18\u0E34\u0E2D\u0E35\u0E01\u0E14\u0E49\u0E27\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: 21300000, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E1E\u0E2D\u0E40\u0E2D\u0E32\u0E28\u0E34\u0E25\u0E1B\u0E30\u0E21\u0E32\u0E23\u0E48\u0E27\u0E21\u0E01\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27\u0E19\u0E48\u0E30\u0E21\u0E31\u0E19\u0E0B\u0E31\u0E1A\u0E0B\u0E49\u0E2D\u0E19\u0E01\u0E27\u0E48\u0E32\u0E17\u0E35\u0E48\u0E04\u0E34\u0E14\u0E40\u0E22\u0E2D\u0E30\u0E40\u0E25\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E40\u0E18\u0E2D\u0E25\u0E2D\u0E07\u0E19\u0E36\u0E01\u0E20\u0E32\u0E1E\u0E27\u0E48\u0E32\u0E40\u0E18\u0E2D\u0E15\u0E49\u0E2D\u0E07\u0E2D\u0E2D\u0E01\u0E20\u0E32\u0E1E\u0E27\u0E32\u0E14"
      showName: 0
    - speaker: 1
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E42\u0E14\u0E22\u0E43\u0E0A\u0E49\u0E44\u0E2D\u0E40\u0E14\u0E35\u0E22\u0E41\u0E15\u0E48\u0E21\u0E35\u0E40\u0E07\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E02\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32"
      showName: 0
    - speaker: 1
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E0A\u0E48\u0E19\u0E01\u0E32\u0E23\u0E08\u0E33\u0E01\u0E31\u0E14\u0E42\u0E17\u0E19\u0E2A\u0E35 \u0E17\u0E48\u0E32\u0E17\u0E32\u0E07 \u0E41\u0E25\u0E30\u0E2D\u0E37\u0E48\u0E19\u0E46"
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E40\u0E18\u0E2D\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49\u0E04\u0E27\u0E32\u0E21\u0E04\u0E34\u0E14\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E2A\u0E23\u0E23\u0E04\u0E4C\u0E21\u0E32\u0E1C\u0E2A\u0E21\u0E01\u0E31\u0E1A\u0E04\u0E27\u0E32\u0E21\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E02\u0E2D\u0E07\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32 "
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E19\u0E31\u0E48\u0E19\u0E41\u0E2B\u0E25\u0E30\u0E04\u0E37\u0E2D\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19 \u0E41\u0E25\u0E30\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E19\u0E31\u0E1A\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E40\u0E27\u0E25\u0E32\u0E17\u0E35\u0E48\u0E08\u0E33\u0E01\u0E31\u0E14"
      showName: 0
    - speaker: 1
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E01\u0E32\u0E23\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E2A\u0E32\u0E22\u0E28\u0E34\u0E25\u0E1B\u0E30\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E21\u0E35\u0E02\u0E2D\u0E1A\u0E40\u0E02\u0E15\u0E2D\u0E22\u0E39\u0E48\u0E41\u0E04\u0E48\u0E01\u0E32\u0E23\u0E27\u0E32\u0E14\u0E20\u0E32\u0E1E "
      showName: 0
    - speaker: 1
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: "\u0E21\u0E31\u0E19\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E01\u0E27\u0E49\u0E32\u0E07\u0E07\u0E07 \u0E21\u0E32\u0E01 \u0E46 \u0E40\u0E0A\u0E48\u0E19 \u0E01\u0E32\u0E23\u0E17\u0E33\u0E42\u0E21\u0E40\u0E14\u0E25\u0E41\u0E25\u0E30\u0E2D\u0E37\u0E48\u0E19 \u0E46"
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E41\u0E25\u0E30\u0E40\u0E07\u0E37\u0E48\u0E2D\u0E19\u0E44\u0E02\u0E01\u0E47\u0E08\u0E30\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E44\u0E1B\u0E15\u0E32\u0E21\u0E1B\u0E23\u0E30\u0E40\u0E20\u0E17\u0E14\u0E49\u0E27\u0E22 "
      showName: 0
    - speaker: 1
      expression: {fileID: -4373619114205778495, guid: 51bd0a7cbf3c7194ba19cd51cba5f401, type: 3}
      text: "\u0E40\u0E0A\u0E48\u0E19\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E08\u0E32\u0E01\u0E01\u0E32\u0E23\u0E17\u0E33\u0E15\u0E32\u0E21\u0E04\u0E27\u0E32\u0E21\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E02\u0E2D\u0E07\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32 "
      showName: 0
