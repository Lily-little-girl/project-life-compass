--- !u!114 &1567891744
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1567891741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f8c0cbdc1b655b4f80cc617ebd0f2db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogueTrigger
  nextSceneName: Drawing minigame
  loadDelay: 0.5
  dialogueManager: {fileID: 593803921}
  playerMovement: {fileID: 1474722731}
  secondCharacter: {fileID: 0}
  firstCharacter: {fileID: 0}
  steps:
  - note: introduce
    type: 0
    showLeft: 0
    showRight: 1
    leftNameSprite: {fileID: 0}
    rightNameSprite: {fileID: 6157333383139386081, guid: 907edf88b09ce5f4d8e6717d4da91fad, type: 3}
    lines:
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E44\u0E07 \u0E40\u0E18\u0E2D\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E44\u0E07\u0E01\u0E31\u0E1A\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E25\u0E48\u0E30"
      showName: 1
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E15\u0E2D\u0E1A\u0E2B\u0E23\u0E2D\u0E01 \u0E09\u0E31\u0E19\u0E41\u0E04\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E1A\u0E17\u0E2A\u0E19\u0E17\u0E19\u0E32\u0E40\u0E09\u0E22\u0E46\u0E41\u0E15\u0E48\u0E25\u0E37\u0E21\u0E44\u0E1B\u0E27\u0E48\u0E32\u0E40\u0E18\u0E2D\u0E41\u0E17\u0E1A\u0E44\u0E21\u0E48\u0E1E\u0E39\u0E14"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E44\u0E21\u0E48\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E1A\u0E42\u0E0B\u0E25\u0E41\u0E25\u0E30\u0E08\u0E39\u0E19 \u0E01\u0E32\u0E23\u0E2D\u0E18\u0E34\u0E1A\u0E32\u0E22\u0E22\u0E37\u0E14\u0E40\u0E22\u0E37\u0E49\u0E2D\u0E41\u0E1A\u0E1A\u0E19\u0E31\u0E48\u0E19\u0E19\u0E48\u0E30\u0E21\u0E35\u0E44\u0E27\u0E49\u0E43\u0E2B\u0E49\u0E01\u0E31\u0E1A\u0E1E\u0E27\u0E01\u0E40\u0E14\u0E47\u0E01\u0E2D\u0E19\u0E38\u0E1A\u0E32\u0E25\u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19\u0E41\u0E2B\u0E25\u0E30\r\n"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E2D\u0E38\u0E49\u0E22 \u0E41\u0E15\u0E48\u0E25\u0E37\u0E21\u0E44\u0E1B \u0E42\u0E0B\u0E25\u0E19\u0E48\u0E30\u0E2D\u0E22\u0E39\u0E48\u0E41\u0E15\u0E48\u0E01\u0E31\u0E1A\u0E1E\u0E27\u0E01\u0E40\u0E14\u0E47\u0E01 \u0E46 \u0E19\u0E35\u0E48\u0E19\u0E32"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E40\u0E2D\u0E32\u0E08\u0E23\u0E34\u0E07 \u0E46 \u0E41\u0E25\u0E49\u0E27\u0E09\u0E31\u0E19\u0E19\u0E48\u0E30 \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2D\u0E04\u0E15\u0E34\u0E2B\u0E23\u0E37\u0E2D\u0E2A\u0E19\u0E43\u0E08\u0E2D\u0E30\u0E44\u0E23\u0E43\u0E19\u0E2A\u0E35\u0E02\u0E2D\u0E07\u0E1E\u0E27\u0E01\u0E40\u0E02\u0E32\u0E40\u0E25\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E01\u0E32\u0E23\u0E44\u0E14\u0E49\u0E40\u0E2B\u0E47\u0E19\u0E1E\u0E27\u0E01\u0E19\u0E31\u0E49\u0E19\u0E17\u0E33\u0E15\u0E31\u0E27\u0E2D\u0E48\u0E2D\u0E19\u0E44\u0E2B\u0E27\u0E07\u0E48\u0E32\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E40\u0E01\u0E34\u0E19\u0E41\u0E25\u0E49\u0E27\u0E1E\u0E22\u0E32\u0E22\u0E32\u0E21\u0E41\u0E0B\u0E30\u0E09\u0E31\u0E19\u0E01\u0E25\u0E31\u0E1A\u0E40\u0E19\u0E35\u0E48\u0E22... \u0E2A\u0E19\u0E38\u0E01\u0E2A\u0E38\u0E14 \u0E46 "
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E09\u0E31\u0E19\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E17\u0E38\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E1C\u0E37\u0E48\u0E2D\u0E44\u0E27\u0E49\u0E41\u0E25\u0E49\u0E27\u0E25\u0E48\u0E30"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E15\u0E49\u0E2D\u0E07\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E04\u0E27\u0E32\u0E21\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E08\u0E32\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E40\u0E19\u0E34\u0E23\u0E4C\u0E14 \u0E46 \u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19 \u0E17\u0E35\u0E48\u0E40\u0E2D\u0E32\u0E42\u0E1B\u0E23\u0E41\u0E01\u0E23\u0E21\u0E1D\u0E36\u0E01\u0E07\u0E32\u0E19\u0E40\u0E14\u0E47\u0E01\u0E43\u0E2B\u0E21\u0E48\u0E21\u0E32 \"\u0E14\u0E31\u0E14\u0E41\u0E1B\u0E25\u0E07\" \u0E40\u0E25\u0E47\u0E01\u0E19\u0E49\u0E2D\u0E22\r\n"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E40\u0E18\u0E2D\u0E19\u0E48\u0E30\u0E0A\u0E2D\u0E1A\u0E04\u0E27\u0E32\u0E21\u0E17\u0E49\u0E32\u0E17\u0E32\u0E22\u0E44\u0E2B\u0E21"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E40\u0E18\u0E2D\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E41\u0E1A\u0E1A\u0E23\u0E31\u0E1A\u0E04\u0E27\u0E32\u0E21\u0E40\u0E2A\u0E35\u0E48\u0E22\u0E07\u0E41\u0E25\u0E30\u0E44\u0E21\u0E48\u0E41\u0E19\u0E48\u0E19\u0E2D\u0E19\u0E41\u0E25\u0E30\u0E21\u0E2D\u0E07\u0E40\u0E2B\u0E47\u0E19\u0E42\u0E2D\u0E01\u0E32\u0E2A\u0E43\u0E19\u0E08\u0E38\u0E14\u0E17\u0E35\u0E48\u0E15\u0E48\u0E33\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E23\u0E36\u0E40\u0E1B\u0E25\u0E48\u0E32"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E40\u0E18\u0E2D\u0E40\u0E1B\u0E47\u0E19\u0E1E\u0E27\u0E01\u0E43\u0E0A\u0E49\u0E40\u0E2B\u0E15\u0E38\u0E1C\u0E25\u0E41\u0E04\u0E48\u0E44\u0E2B\u0E19 \u0E41\u0E25\u0E30\u0E01\u0E25\u0E49\u0E32\u0E17\u0E35\u0E48\u0E08\u0E30\u0E25\u0E07\u0E21\u0E37\u0E2D\u0E43\u0E19\u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E01\u0E25\u0E31\u0E27\u0E41\u0E25\u0E30\u0E21\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E40\u0E18\u0E2D\u0E1A\u0E49\u0E32\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E49\u0E22 "
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E19\u0E48\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E25\u0E31\u0E01\u0E29\u0E13\u0E30\u0E2B\u0E25\u0E31\u0E01 \u0E46 \u0E02\u0E2D\u0E07\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E2A\u0E32\u0E22\u0E1A\u0E23\u0E34\u0E2B\u0E32\u0E23 \u0E08\u0E23\u0E34\u0E07 \u0E46 \u0E41\u0E25\u0E49\u0E27\u0E22\u0E31\u0E07\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E17\u0E35\u0E48\u0E25\u0E36\u0E01\u0E01\u0E27\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E09\u0E31\u0E19\u0E19\u0E48\u0E30\u0E41\u0E04\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E08\u0E30\u0E43\u0E2B\u0E49\u0E40\u0E18\u0E2D\u0E21\u0E2D\u0E07\u0E40\u0E2B\u0E47\u0E19\u0E20\u0E32\u0E1E\u0E23\u0E27\u0E21\u0E04\u0E23\u0E48\u0E32\u0E27 \u0E46 \u0E02\u0E2D\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E17\u0E35\u0E48\u0E41\u0E25\u0E30\u0E04\u0E27\u0E32\u0E21\u0E23\u0E31\u0E1A\u0E1C\u0E34\u0E14\u0E0A\u0E2D\u0E1A\u0E17\u0E35\u0E48\u0E21\u0E32\u0E01\u0E31\u0E1A\u0E43\u0E08\u0E23\u0E31\u0E01\u0E15\u0E48\u0E2D\u0E07\u0E32\u0E19\u0E19\u0E35\u0E49 "
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
