    duration: 0.5
    showLeft: 1
    showRight: 1
    leftSprite: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
    rightSprite: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
    leftNameSprite: {fileID: -8052914020376505181, guid: 83908faf13289564fa84d263999d36a6, type: 3}
    rightNameSprite: {fileID: 6157333383139386081, guid: 907edf88b09ce5f4d8e6717d4da91fad, type: 3}
    lines:
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: " \u0E40\u0E2E\u0E49 \u0E16\u0E36\u0E07\u0E15\u0E32\u0E09\u0E31\u0E19\u0E41\u0E25\u0E49\u0E27 \u0E2A\u0E48\u0E07\u0E40\u0E14\u0E47\u0E01\u0E43\u0E2B\u0E21\u0E48\u0E21\u0E32"
      showName: 0
    - speaker: 0
      expression: {fileID: -8333434954521013970, guid: d787bed976c0fe44f98796dd68f7ad74, type: 3}
      text: "\u0E2D\u0E30\u0E44\u0E23\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D\u0E40\u0E19\u0E35\u0E48\u0E22"
      showName: 1
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E01\u0E47 \u0E09\u0E31\u0E19\u0E40\u0E1A\u0E37\u0E48\u0E2D\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E17\u0E33\u0E40\u0E25\u0E22\u0E17\u0E31\u0E01\u0E44\u0E1B\u0E01\u0E27\u0E19\u0E42\u0E0B\u0E25"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E40\u0E02\u0E32\u0E01\u0E47\u0E2B\u0E25\u0E38\u0E14\u0E1B\u0E32\u0E01\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E04\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E43\u0E2B\u0E21\u0E48\u0E2A\u0E38\u0E14\u0E2E\u0E2D\u0E15\u0E08\u0E19\u0E44\u0E14\u0E49"
      showName: 0
    - speaker: 0
      expression: {fileID: -8333434954521013970, guid: d787bed976c0fe44f98796dd68f7ad74, type: 3}
      text: "\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E31\u0E1A\u0E40\u0E18\u0E2D\u0E01\u0E31\u0E19\u0E40\u0E25\u0E48\u0E32"
      showName: 1
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E17\u0E38\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E40\u0E19\u0E35\u0E48\u0E22\u0E17\u0E33\u0E15\u0E31\u0E27\u0E41\u0E1B\u0E25\u0E01\u0E44\u0E1B\u0E2B\u0E21\u0E14 \u0E09\u0E31\u0E19\u0E01\u0E47\u0E19\u0E36\u0E01\u0E27\u0E48\u0E32\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E43\u0E2B\u0E0D\u0E48\u0E2D\u0E30\u0E44\u0E23"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E1E\u0E2D\u0E21\u0E32\u0E23\u0E39\u0E49\u0E27\u0E48\u0E32\u0E1E\u0E27\u0E01\u0E40\u0E18\u0E2D\u0E41\u0E04\u0E48\u0E15\u0E37\u0E48\u0E19\u0E40\u0E15\u0E49\u0E19\u0E01\u0E31\u0E1A\u0E04\u0E19\u0E41\u0E1B\u0E25\u0E01\u0E2B\u0E19\u0E49\u0E32\u0E15\u0E31\u0E27\u0E44\u0E23\u0E49\u0E2A\u0E35\u0E43\u0E19\u0E2D\u0E32\u0E22\u0E38\u0E01\u0E49\u0E32\u0E27\u0E40\u0E02\u0E49\u0E32\u0E40\u0E25\u0E022\u0E40\u0E19\u0E35\u0E48\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E21\u0E31\u0E19\u0E19\u0E48\u0E32\u0E1C\u0E34\u0E14\u0E2B\u0E27\u0E31\u0E07\u0E08\u0E23\u0E34\u0E07\u0E46\u0E19\u0E30 \u0E17\u0E35\u0E48\u0E1E\u0E27\u0E01\u0E40\u0E18\u0E2D\u0E17\u0E33\u0E40\u0E1B\u0E47\u0E19\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D "
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E08\u0E23\u0E34\u0E07\u0E46\u0E41\u0E25\u0E49\u0E27\u0E41\u0E04\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E25\u0E49\u0E32\u0E07\u0E2A\u0E21\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E40\u0E02\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E1E\u0E27\u0E01\u0E40\u0E14\u0E35\u0E22\u0E27\u0E01\u0E31\u0E1A\u0E40\u0E18\u0E2D"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E16\u0E49\u0E32\u0E09\u0E31\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E39\u0E19\u0E35\u0E48\u0E01\u0E25\u0E32\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E2A\u0E35\u0E40\u0E02\u0E35\u0E22\u0E27\u0E2B\u0E23\u0E37\u0E2D\u0E1F\u0E49\u0E32\u0E40\u0E19\u0E35\u0E48\u0E22 \u0E04\u0E07\u0E08\u0E30\u0E40\u0E0A\u0E22\u0E2A\u0E38\u0E14\u0E46\u0E44\u0E1B\u0E40\u0E25\u0E22"
      showName: 0
    - speaker: 0
      expression: {fileID: -8333434954521013970, guid: d787bed976c0fe44f98796dd68f7ad74, type: 3}
      text: "\u0E2B\u0E38\u0E1A\u0E1B\u0E32\u0E01\u0E19\u0E30\u0E22\u0E31\u0E22\u0E2B\u0E31\u0E27\u0E40\u0E2A\u0E49\u0E19\u0E40\u0E25\u0E37\u0E2D\u0E14 \u0E19\u0E31\u0E48\u0E19\u0E19\u0E48\u0E30\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E27\u0E34\u0E18\u0E35\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E2A\u0E35\u0E43\u0E19\u0E15\u0E31\u0E27\u0E1E\u0E27\u0E01\u0E40\u0E23\u0E32\u0E0B\u0E31\u0E01\u0E2B\u0E19\u0E48\u0E2D\u0E22"
      showName: 1
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: "\u0E41\u0E25\u0E49\u0E27\u0E22\u0E31\u0E22\u0E2B\u0E31\u0E27\u0E40\u0E19\u0E48\u0E32\u0E41\u0E1A\u0E1A\u0E40\u0E18\u0E2D\u0E08\u0E30\u0E44\u0E1B\u0E23\u0E39\u0E49\u0E2D\u0E30\u0E44\u0E23 \u0E40\u0E18\u0E2D\u0E22\u0E38\u0E48\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E41\u0E15\u0E48\u0E01\u0E31\u0E1A\u0E1E\u0E27\u0E01\u0E20\u0E32\u0E1E\u0E27\u0E32\u0E14\u0E02\u0E19\u0E1F\u0E39 \u0E46 \u0E19\u0E35\u0E48\u0E19\u0E32\r\n"
      showName: 0
    - speaker: 0
      expression: {fileID: 7069736652530832915, guid: ae2ff7c8285912f4493e40b3dce7706a, type: 3}
      text: o///o
      showName: 1
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: " \u0E40\u0E2D\u0E32\u0E40\u0E16\u0E2D\u0E30 \u0E09\u0E31\u0E19\u0E41\u0E04\u0E48\u0E2A\u0E48\u0E07\u0E2A\u0E31\u0E22\u0E27\u0E48\u0E32\u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E39\u0E19\u0E35\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E14\u0E35"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E02\u0E19\u0E32\u0E14\u0E40\u0E18\u0E2D\u0E22\u0E31\u0E07\u0E25\u0E32\u0E01\u0E40\u0E02\u0E32\u0E21\u0E32\u0E08\u0E32\u0E01\u0E28\u0E39\u0E19\u0E22\u0E4C\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22 \u0E41\u0E25\u0E49\u0E27\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2D\u0E30\u0E44\u0E23\u0E17\u0E35\u0E48\u0E09\u0E31\u0E19\u0E08\u0E30\u0E17\u0E33\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E2D\u0E35\u0E01\u0E2D\u0E22\u0E48\u0E32\u0E07 \u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E21\u0E32\u0E15\u0E31\u0E27\u0E40\u0E1B\u0E25\u0E48\u0E32 "
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E16\u0E49\u0E32\u0E40\u0E18\u0E2D\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E40\u0E27\u0E25\u0E32\u0E08\u0E32\u0E01\u0E43\u0E04\u0E23\u0E2A\u0E31\u0E01\u0E04\u0E19\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E49\u0E2D\u0E22\u0E01\u0E47\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E27\u0E34\u0E18\u0E35\u0E42\u0E19\u0E49\u0E21\u0E19\u0E49\u0E32\u0E27\u0E43\u0E08\u0E2A\u0E34"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E19\u0E35\u0E48\u0E40\u0E08\u0E49\u0E32\u0E2B\u0E19\u0E39"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E44\u0E1B\u0E01\u0E31\u0E1A\u0E09\u0E31\u0E19\u0E41\u0E25\u0E49\u0E27 3000 bucks \u0E08\u0E30\u0E40\u0E1B\u0E47\u0E19\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: " \u0E40\u0E08\u0E2D\u0E01\u0E31\u0E19\u0E17\u0E35\u0E48\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E19\u0E30 \u0E41\u0E04\u0E48\u0E40\u0E14\u0E34\u0E19\u0E15\u0E23\u0E07\u0E44\u0E1B\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E22\u0E46\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E01\u0E47\u0E40\u0E08\u0E2D"
