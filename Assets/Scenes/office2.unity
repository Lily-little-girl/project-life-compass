    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: ...
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E40\u0E2D\u0E48\u0E2D \u0E1C\u0E21\u0E41\u0E1F\u0E25\u0E0A\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
      showName: 1
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E40\u0E2D\u0E32\u0E25\u0E48\u0E30 \u0E40\u0E23\u0E32\u0E21\u0E32\u0E40\u0E23\u0E34\u0E48\u0E21\u0E40\u0E01\u0E21\u0E01\u0E31\u0E19\u0E40\u0E25\u0E22 "
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E2B\u0E32\u0E01\u0E04\u0E38\u0E13\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E17\u0E35\u0E48\u0E0A\u0E2D\u0E1A\u0E15\u0E31\u0E49\u0E07\u0E04\u0E33\u0E16\u0E32\u0E21 \u0E0A\u0E2D\u0E1A\u0E41\u0E01\u0E49\u0E1B\u0E23\u0E34\u0E28\u0E19\u0E32 \u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E27\u0E25\u0E32\u0E40\u0E08\u0E2D\u0E1B\u0E31\u0E0D\u0E2B\u0E32\u0E41\u0E25\u0E49\u0E27\u0E0A\u0E2D\u0E1A\u0E04\u0E34\u0E14\u0E27\u0E34\u0E40\u0E04\u0E23\u0E32\u0E30\u0E2B\u0E4C\u0E2B\u0E32\u0E40\u0E2B\u0E15\u0E38\u0E41\u0E25\u0E30\u0E1C\u0E25\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E23\u0E30\u0E1A\u0E1A \u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E2A\u0E32\u0E22\u0E15\u0E23\u0E23\u0E01\u0E30\u0E04\u0E37\u0E2D\u0E1E\u0E37\u0E49\u0E19\u0E17\u0E35\u0E48\u0E17\u0E35\u0E48\u0E40\u0E2B\u0E21\u0E32\u0E30\u0E01\u0E31\u0E1A\u0E04\u0E38\u0E13\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E2A\u0E32\u0E22\u0E19\u0E35\u0E49\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E41\u0E04\u0E48\u0E01\u0E32\u0E23\u0E40\u0E01\u0E48\u0E07\u0E04\u0E13\u0E34\u0E15\u0E28\u0E32\u0E2A\u0E15\u0E23\u0E4C \u0E41\u0E15\u0E48\u0E04\u0E37\u0E2D \u0E01\u0E32\u0E23\u0E04\u0E34\u0E14\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E21\u0E35\u0E40\u0E2B\u0E15\u0E38\u0E1C\u0E25 \u0E41\u0E25\u0E30\u0E01\u0E32\u0E23\u0E41\u0E15\u0E01\u0E1B\u0E31\u0E0D\u0E2B\u0E32\u0E43\u0E2B\u0E0D\u0E48\u0E43\u0E2B\u0E49\u0E40\u0E25\u0E47\u0E01\u0E25\u0E07\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E41\u0E01\u0E49\u0E44\u0E02\u0E17\u0E35\u0E25\u0E30\u0E08\u0E38\u0E14"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E16\u0E49\u0E32\u0E01\u0E33\u0E25\u0E31\u0E07\u0E21\u0E2D\u0E07\u0E2B\u0E32\u0E40\u0E2A\u0E49\u0E19\u0E17\u0E32\u0E07\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E17\u0E35\u0E48\u0E17\u0E49\u0E32\u0E17\u0E32\u0E22 \u0E44\u0E14\u0E49\u0E43\u0E0A\u0E49\u0E04\u0E27\u0E32\u0E21\u0E04\u0E34\u0E14\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E2A\u0E23\u0E23\u0E04\u0E4C\u0E1A\u0E19\u0E1E\u0E37\u0E49\u0E19\u0E10\u0E32\u0E19\u0E02\u0E2D\u0E07\u0E04\u0E27\u0E32\u0E21\u0E40\u0E1B\u0E47\u0E19\u0E08\u0E23\u0E34\u0E07 \u0E41\u0E25\u0E30\u0E21\u0E35\u0E42\u0E2D\u0E01\u0E32\u0E2A\u0E40\u0E15\u0E34\u0E1A\u0E42\u0E15\u0E2A\u0E39\u0E07 "
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E25\u0E2D\u0E07\u0E40\u0E1B\u0E34\u0E14\u0E43\u0E08\u0E43\u0E2B\u0E49\u0E01\u0E31\u0E1A\u0E2D\u0E32\u0E0A\u0E35\u0E1E\u0E2A\u0E32\u0E22\u0E15\u0E23\u0E23\u0E01\u0E30\u0E14\u0E39\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A \u0E44\u0E2B\u0E19 \u0E46 \u0E25\u0E2D\u0E07\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21\u0E19\u0E35\u0E49\u0E14\u0E39\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E40\u0E01\u0E21\u0E19\u0E35\u0E49\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E01\u0E21\u0E1B\u0E49\u0E2D\u0E19\u0E04\u0E33\u0E2A\u0E31\u0E48\u0E07\u0E41\u0E1A\u0E1A\u0E40\u0E23\u0E35\u0E22\u0E1A\u0E07\u0E48\u0E32\u0E22 \u0E2A\u0E34\u0E48\u0E07\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E15\u0E49\u0E2D\u0E07\u0E17\u0E33\u0E01\u0E47\u0E41\u0E04\u0E48 ..."
      showName: 0
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: ...
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E04\u0E25\u0E34\u0E01\u0E17\u0E35\u0E48 \u0E0A\u0E48\u0E2D\u0E07 bubble \u0E2A\u0E35\u0E14\u0E33\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E08\u0E30\u0E2D\u0E19\u0E38\u0E0D\u0E32\u0E15\u0E34\u0E43\u0E2B\u0E49\u0E1E\u0E34\u0E21\u0E1E\u0E4C "
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E17\u0E35\u0E19\u0E35\u0E49\u0E25\u0E2D\u0E07\u0E1E\u0E34\u0E21\u0E1E\u0E4C WASD \u0E21\u0E31\u0E19\u0E08\u0E30\u0E16\u0E39\u0E01\u0E40\u0E1B\u0E25\u0E35\u0E48\u0E22\u0E19\u0E40\u0E1B\u0E47\u0E19 \u2191\u2190\u2193\u2192"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E19\u0E31\u0E48\u0E19\u0E04\u0E37\u0E2D\u0E17\u0E34\u0E28\u0E17\u0E32\u0E07\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E08\u0E30\u0E40\u0E14\u0E34\u0E19\u0E44\u0E1B\u0E02\u0E49\u0E32\u0E07\u0E2B\u0E19\u0E49\u0E32\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E01\u0E14\u0E1B\u0E38\u0E48\u0E21\u0E22\u0E37\u0E19\u0E22\u0E31\u0E19"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E40\u0E1B\u0E49\u0E32\u0E2B\u0E21\u0E32\u0E22\u0E04\u0E37\u0E2D\u0E40\u0E14\u0E34\u0E19\u0E44\u0E1B\u0E43\u0E2B\u0E49\u0E16\u0E36\u0E07\u0E18\u0E07\u0E2A\u0E35\u0E41\u0E14\u0E07"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E08\u0E30\u0E1E\u0E34\u0E21\u0E1E\u0E4C\u0E40\u0E17\u0E48\u0E32\u0E44\u0E2B\u0E23\u0E48\u0E01\u0E47\u0E44\u0E01\u0E49\u0E41\u0E15\u0E48\u0E01\u0E14\u0E22\u0E37\u0E19\u0E22\u0E31\u0E19\u0E44\u0E14\u0E49\u0E04\u0E23\u0E31\u0E49\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27\u0E15\u0E48\u0E2D\u0E14\u0E48\u0E32\u0E19\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
