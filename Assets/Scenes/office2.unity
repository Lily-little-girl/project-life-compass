    lines:
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: "\u0E42\u0E23\u0E2A \u0E40\u0E18\u0E2D\u0E40\u0E2D\u0E32\u0E2A\u0E32\u0E22\u0E0A\u0E32\u0E23\u0E4C\u0E08\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\u0E44\u0E1B\u0E44\u0E27\u0E49\u0E17\u0E35\u0E48\u0E44\u0E2B\u0E19-"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: " \u0E19\u0E35\u0E48\u0E44\u0E07 \u0E15\u0E34\u0E27\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E04\u0E19\u0E2A\u0E38\u0E14\u0E17\u0E49\u0E32\u0E22\u0E25\u0E48\u0E30"
      showName: 1
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: "\u0E15\u0E34\u0E27\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E2D\u0E30\u0E44\u0E23\u0E02\u0E2D\u0E07\u0E40\u0E18\u0E2D"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: " \u0E01\u0E47\u0E17\u0E38\u0E01 \u0E46 \u0E04\u0E19\u0E15\u0E37\u0E48\u0E19\u0E40\u0E15\u0E49\u0E19\u0E17\u0E35\u0E48\u0E08\u0E30\u0E44\u0E14\u0E49\u0E2A\u0E2D\u0E19\u0E40\u0E14\u0E47\u0E01\u0E43\u0E2B\u0E21\u0E48\u0E44\u0E23\u0E49\u0E2A\u0E35\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E40\u0E2B\u0E23\u0E2D \u0E19\u0E32\u0E22\u0E19\u0E35\u0E48\u0E21\u0E31\u0E19\u0E17\u0E36\u0E48\u0E21\u0E08\u0E23\u0E34\u0E07\u0E46"
      showName: 0
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: "\u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E2A\u0E19\u0E43\u0E08\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E01\u0E35\u0E48\u0E22\u0E27\u0E01\u0E31\u0E1A\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E35\u0E49\u0E17\u0E31\u0E49\u0E07\u0E19\u0E31\u0E49\u0E19"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E16\u0E49\u0E32\u0E44\u0E21\u0E48\u0E2A\u0E19\u0E43\u0E08\u0E01\u0E47\u0E40\u0E25\u0E34\u0E01\u0E40\u0E15\u0E23\u0E35\u0E22\u0E21\u0E40\u0E01\u0E21\u0E43\u0E2B\u0E49\u0E40\u0E02\u0E32\u0E2A\u0E31\u0E01\u0E17\u0E35\u0E2A\u0E34"
      showName: 0
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: "\u0E01..\u0E40\u0E01\u0E21\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E25\u0E48\u0E32 \u0E44\u0E21\u0E48\u0E21\u0E35\u0E2A\u0E31\u0E01\u0E2B\u0E19\u0E48\u0E2D\u0E22"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: ' ...'
      showName: 0
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: "\u0E01\u0E47\u0E44\u0E14\u0E49 \u0E09\u0E31\u0E19\u0E08\u0E30\u0E2A\u0E2D\u0E19\u0E04\u0E19\u0E41\u0E1B\u0E25\u0E01\u0E2B\u0E19\u0E49\u0E32\u0E41\u0E04\u0E48\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E17\u0E38\u0E01\u0E04\u0E19\u0E17\u0E33\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E01\u0E31\u0E1A\u0E21\u0E31\u0E19\u0E04\u0E37\u0E2D\u0E02\u0E19\u0E1A\u0E18\u0E23\u0E23\u0E21\u0E40\u0E19\u0E35\u0E22\u0E21\u0E41\u0E1B\u0E25\u0E01 \u0E46 \u0E2A\u0E48\u0E27\u0E19\u0E40\u0E18\u0E2D\u0E43\u0E2A\u0E2B\u0E31\u0E27\u0E44\u0E1B\u0E44\u0E2B\u0E19\u0E01\u0E47\u0E44\u0E1B"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: "\u0E09\u0E31\u0E19\u0E23\u0E39\u0E49\u0E19\u0E30 \u0E27\u0E48\u0E32\u0E19\u0E32\u0E22\u0E14\u0E35\u0E43\u0E08\u0E17\u0E35\u0E48\u0E40\u0E02\u0E32\u0E40\u0E25\u0E48\u0E19\u0E40\u0E01\u0E21\u0E02\u0E2D\u0E07\u0E19\u0E32\u0E22"
      showName: 0
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: " \u0E21\u0E31\u0E19\u0E01\u0E47\u0E41\u0E04\u0E48\u0E40\u0E01\u0E21 \u0E09\u0E31\u0E19\u0E01\u0E47\u0E41\u0E04\u0E48\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E08\u0E1A \u0E46 \u0E44\u0E1B \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49 \u0E14..\u0E14\u0E35\u0E43\u0E08\u0E2A\u0E31\u0E01\u0E2B\u0E19\u0E48\u0E2D\u0E22"
      showName: 0
    - speaker: 0
      expression: {fileID: 9056637563498302115, guid: b351a11a6056e954f8e9fbd20190899a, type: 3}
      text: "\u0E42\u0E23\u0E2A \u0E09\u0E31\u0E19\u0E1E\u0E39\u0E14\u0E08\u0E23\u0E34\u0E07\u0E46\u0E19\u0E30 \u0E2D\u0E2D\u0E01\u0E44\u0E1B\u0E44\u0E14\u0E49\u0E41\u0E25\u0E49\u0E27"
      showName: 0
    - speaker: 1
      expression: {fileID: -5079735398247820582, guid: 78dcc3e654e583e4fadbb2cab1207eb6, type: 3}
      text: " \u0E19\u0E35\u0E48\u0E19\u0E32\u0E22\u0E01\u0E25\u0E49\u0E32\u0E43\u0E25\u0E48\u0E09\u0E31\u0E19\u0E40\u0E2B\u0E23\u0E2D\u0E40\u0E19\u0E35\u0E48\u0E22"
      showName: 0
    - speaker: 0
      expression: {fileID: -5161386350738444970, guid: d9fc979ba42958340a8d84df3a861f16, type: 3}
      text: "\u0E43\u0E0A\u0E48"
      showName: 0
    - speaker: 1
      expression: {fileID: 7664423919492430822, guid: 35f330f9166998d469f43da86309794f, type: 3}
      text: " \u0E08\u0E23\u0E34\u0E07 \u0E46 \u0E09\u0E31\u0E19\u0E01\u0E47\u0E01\u0E30\u0E27\u0E48\u0E32\u0E08\u0E30\u0E44\u0E1B\u0E2D\u0E22\u0E39\u0E48\u0E41\u0E25\u0E49\u0E27\u0E41\u0E15\u0E48\u0E1E\u0E2D\u0E19\u0E32\u0E22\u0E1E\u0E39\u0E14\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49\u0E41\u0E25\u0E49\u0E27\u0E21\u0E31\u0E19\u0E19\u0E48\u0E32\u0E2B\u0E21\u0E31\u0E48\u0E19\u0E43\u0E2A\u0E49\u0E0A\u0E30\u0E21\u0E31\u0E14"
