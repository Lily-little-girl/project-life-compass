      text: "\u0E40\u0E2D\u0E32\u0E25\u0E30 \u0E1C\u0E21\u0E0A\u0E37\u0E48\u0E2D \u0E42\u0E0B\u0E25 \u0E19\u0E30 \u0E40\u0E18\u0E2D\u0E0A\u0E37\u0E48\u0E2D\u0E2D\u0E30\u0E44\u0E23\u0E40\u0E2B\u0E23\u0E2D"
    - speaker: 1
      expression: {fileID: -6666077834460347998, guid: a3a88626f312fdd459fcefe67df7fd97, type: 3}
      text: "[name] \u0E2A\u0E34\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E07\u0E32\u0E19\u0E2A\u0E1A\u0E32\u0E22 \u0E46 \u0E04\u0E23\u0E31\u0E1A \u0E14\u0E39\u0E41\u0E25\u0E40\u0E14\u0E47\u0E01 \u0E46 \u0E04\u0E2D\u0E22\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E2A\u0E31\u0E1E\u0E40\u0E1E\u0E40\u0E2B\u0E23\u0E30\u0E40\u0E17\u0E48\u0E32\u0E19\u0E31\u0E49\u0E19\u0E40\u0E2D\u0E07"
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E2B\u0E31\u0E27\u0E43\u0E08\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E17\u0E33\u0E07\u0E32\u0E19\u0E2A\u0E32\u0E22\u0E1A\u0E23\u0E34\u0E01\u0E32\u0E23\u0E40\u0E19\u0E35\u0E48\u0E22 \u0E04\u0E37\u0E2D\u0E01\u0E32\u0E23\u0E21\u0E35\u0E43\u0E08\u0E23\u0E31\u0E01\u0E43\u0E19\u0E01\u0E32\u0E23\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D"
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E40\u0E17\u0E04\u0E19\u0E34\u0E04\u0E04\u0E37\u0E2D\u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15\u0E04\u0E19\u0E23\u0E2D\u0E1A\u0E02\u0E49\u0E32\u0E07 \u0E17\u0E31\u0E49\u0E07\u0E2A\u0E35\u0E2B\u0E19\u0E49\u0E32\u0E41\u0E25\u0E30\u0E17\u0E48\u0E32\u0E17\u0E32\u0E07"
    - speaker: 1
      expression: {fileID: -6666077834460347998, guid: a3a88626f312fdd459fcefe67df7fd97, type: 3}
      text: "\u0E40\u0E02\u0E49\u0E32\u0E2B\u0E32\u0E1E\u0E27\u0E01\u0E40\u0E02\u0E32\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2A\u0E38\u0E20\u0E32\u0E1E\u0E14\u0E49\u0E27\u0E22\u0E23\u0E2D\u0E22\u0E22\u0E34\u0E49\u0E21 \u0E04\u0E27\u0E32\u0E21\u0E01\u0E23\u0E30\u0E09\u0E31\u0E1A\u0E01\u0E23\u0E30\u0E40\u0E09\u0E07 "
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E44\u0E21\u0E48\u0E27\u0E48\u0E32\u0E08\u0E30\u0E40\u0E08\u0E2D\u0E04\u0E19\u0E41\u0E1A\u0E1A\u0E44\u0E2B\u0E19 \u0E40\u0E25\u0E22\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49\u0E04\u0E27\u0E32\u0E21\u0E04\u0E27\u0E32\u0E21\u0E2D\u0E14\u0E17\u0E19\u0E41\u0E25\u0E30\u0E43\u0E08\u0E40\u0E22\u0E47\u0E19\u0E1E\u0E2D\u0E2A\u0E21\u0E04\u0E27\u0E23\u0E40\u0E25\u0E22..."
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: " \u0E02\u0E19\u0E32\u0E14\u0E04\u0E19\u0E17\u0E35\u0E48\u0E21\u0E35\u0E43\u0E08\u0E23\u0E31\u0E01\u0E07\u0E32\u0E19\u0E19\u0E35\u0E49\u0E40\u0E19\u0E35\u0E48\u0E22 \u0E22\u0E31\u0E07\u0E40\u0E04\u0E22\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E01\u0E14\u0E14\u0E31\u0E19\u0E43\u0E19\u0E2B\u0E25\u0E32\u0E22\u0E46\u0E04\u0E23\u0E31\u0E49\u0E07\u0E40\u0E25\u0E22"
    - speaker: 1
      expression: {fileID: -6666077834460347998, guid: a3a88626f312fdd459fcefe67df7fd97, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E01\u0E32\u0E23\u0E44\u0E14\u0E49\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E2B\u0E25\u0E37\u0E2D\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E01\u0E47\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E1C\u0E21\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E14\u0E35\u0E02\u0E36\u0E49\u0E19\u0E08\u0E19\u0E01\u0E25\u0E31\u0E1A\u0E21\u0E32\u0E21\u0E35\u0E41\u0E23\u0E07\u0E17\u0E33\u0E07\u0E32\u0E19\u0E44\u0E14\u0E49\u0E04\u0E23\u0E31\u0E1A \r\n\u0E15\u0E49\u0E2D\u0E07\u0E21\u0E35\u0E43\u0E04\u0E23\u0E2A\u0E31\u0E01\u0E04\u0E19\u0E04\u0E2D\u0E22\u0E14\u0E39\u0E41\u0E25\u0E40\u0E14\u0E47\u0E01\u0E46\u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21\u0E25\u0E48\u0E30"
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E1C\u0E21\u0E23\u0E39\u0E49\u0E27\u0E48\u0E32\u0E21\u0E31\u0E19\u0E2D\u0E32\u0E08\u0E08\u0E30\u0E22\u0E32\u0E01\u0E41\u0E25\u0E30\u0E40\u0E01\u0E23\u0E47\u0E07 \u0E46 \u0E0A\u0E48\u0E27\u0E07\u0E41\u0E23\u0E01 "
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E40\u0E18\u0E2D\u0E44\u0E21\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E31\u0E07\u0E27\u0E25\u0E40\u0E25\u0E22\u0E19\u0E30\u0E41\u0E04\u0E48\u0E17\u0E33\u0E43\u0E08\u0E43\u0E2B\u0E49\u0E40\u0E22\u0E47\u0E19 \u0E16\u0E49\u0E32\u0E19\u0E36\u0E01\u0E2D\u0E30\u0E44\u0E23\u0E44\u0E21\u0E48\u0E2D\u0E2D\u0E01\u0E43\u0E2B\u0E49\u0E19\u0E36\u0E01\u0E16\u0E36\u0E07\u0E04\u0E33\u0E41\u0E19\u0E30\u0E19\u0E33\u0E02\u0E2D\u0E07\u0E1C\u0E21\u0E2B\u0E23\u0E37\u0E2D\u0E16\u0E32\u0E21\u0E1C\u0E21\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22"
    - speaker: 1
      expression: {fileID: -6666077834460347998, guid: a3a88626f312fdd459fcefe67df7fd97, type: 3}
      text: "\u0E41\u0E15\u0E48\u0E40\u0E14\u0E47\u0E01 \u0E46 \u0E17\u0E35\u0E48\u0E19\u0E35\u0E48\u0E40\u0E19\u0E35\u0E48\u0E22...\u0E2D\u0E32\u0E08\u0E08\u0E30\u0E14\u0E37\u0E49\u0E2D\u0E19\u0E34\u0E14\u0E19\u0E36\u0E07\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A"
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E40\u0E27\u0E25\u0E32\u0E19\u0E35\u0E49\u0E40\u0E14\u0E47\u0E01\u0E46\u0E1E\u0E36\u0E48\u0E07\u0E08\u0E30\u0E17\u0E32\u0E19\u0E02\u0E49\u0E32\u0E27\u0E01\u0E25\u0E32\u0E07\u0E27\u0E31\u0E19 \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E01\u0E47\u0E08\u0E30\u0E21\u0E35\u0E41\u0E23\u0E07\u0E2D\u0E2D\u0E01\u0E44\u0E1B\u0E40\u0E25\u0E48\u0E19"
    - speaker: 1
      expression: {fileID: -6666077834460347998, guid: a3a88626f312fdd459fcefe67df7fd97, type: 3}
      text: "\u0E40\u0E1B\u0E47\u0E19\u0E08\u0E31\u0E07\u0E2B\u0E27\u0E30\u0E17\u0E35\u0E48\u0E15\u0E49\u0E2D\u0E07\u0E04\u0E2D\u0E22\u0E2A\u0E31\u0E07\u0E40\u0E01\u0E15\u0E40\u0E1B\u0E47\u0E19\u0E1E\u0E34\u0E40\u0E28\u0E29\u0E40\u0E25\u0E22\u0E19\u0E30\u0E04\u0E23\u0E31\u0E1A "
    - speaker: 1
      expression: {fileID: 4670757086692290484, guid: efe546f5b800859439a60aa162ce1e27, type: 3}
      text: "\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E16\u0E49\u0E32\u0E04\u0E25\u0E32\u0E14\u0E2A\u0E32\u0E22\u0E15\u0E32\u0E44\u0E1B...\u0E01\u0E47\u0E2D\u0E32\u0E08\u0E40\u0E01\u0E34\u0E14\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E44\u0E21\u0E48\u0E14\u0E35\u0E02\u0E36\u0E49\u0E19\u0E44\u0E14\u0E49"
    destination: {fileID: 1481430924}
    waitUntilArrived: 1
  onDialogueFinished:
